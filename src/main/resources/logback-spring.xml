<?xml version="1.0" encoding="UTF-8"?>
<!--
  日志配置：控制台 + 滚动文件
  - 文件位置：${LOG_DIR:-logs}/database-operation-agent.log（可用环境变量 LOG_DIR 覆盖，默认应用工作目录下 logs/）
  - 滚动策略：按天 + 单文件 50MB，保留 30 天 / 总量上限 1GB，历史归档 gzip 压缩
  - 级别：根 INFO；业务包 DEBUG（可被 application.yml 的 logging.level 覆盖）
-->
<configuration>
    <property name="LOG_DIR" value="${LOG_DIR:-logs}"/>
    <property name="APP_NAME" value="database-operation-agent"/>
    <property name="CONSOLE_PATTERN"
              value="%d{HH:mm:ss.SSS} %highlight(%-5level) %cyan(%logger{36}) - %msg%n"/>
    <property name="FILE_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{48} - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/${APP_NAME}.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/${APP_NAME}.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${FILE_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 业务包 DEBUG（与 application.yml 的 logging.level 一致，后者优先级更高） -->
    <logger name="com.mingzy.dbagent" level="DEBUG"/>
    <!-- 连接池心跳日志保持 INFO，避免刷屏 -->
    <logger name="com.zaxxer.hikari" level="INFO"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>
